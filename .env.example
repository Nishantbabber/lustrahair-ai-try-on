# AI Provider: "openrouter", "gemini", or "demo" (default)
AI_PROVIDER=openrouter

# OpenRouter API Configuration (supports google/gemini-3.1-flash-image)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemini-3.1-flash-image

# Alternatively, Google Gemini Direct API Configuration:
# AI_PROVIDER=gemini
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-2.5-flash-image

# Optional: B2B contact email shown in the "Get in Touch" dialog.
# Leave unset (or empty) to show a "not yet configured" message instead.
# Never commit a real email address to source control.
# NEXT_PUBLIC_CONTACT_EMAIL=hello@yourdomain.com
